{
  "name": "ai-radio-hunt-companion",
  "version": "0.1.0",
  "private": true,
  "description": "Local bridge between the AI Radio Hunt Project Zomboid mod and a local Ollama instance.",
  "type": "commonjs",
  "main": "index.js",
  "bin": "index.js",
  "scripts": {
    "start": "node index.js",
    "build": "pkg . --out-path dist"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.22.0"
  },
  "pkg": {
    "targets": [
      "node22-macos-arm64",
      "node22-macos-x64",
      "node22-win-x64"
    ]
  }
}
